# Copy this file to .env and fill in the values you need, then just run
# `python server.py` with nothing on the command line. Values already set in
# your actual shell environment still take priority over this file.

# --- Where your data lives (pick one) ---
# A live POD:
POD_BASE_URL=https://your-pod-provider/your-username/agents/
# ...or read from a local directory instead (leave POD_BASE_URL unset):
# LOCAL_CONTEXT_DIR=./data

# --- Broker -> POD auth (optional, see SETUP.md §3b) ---
# Omit both to fall back to unauthenticated GET (only works on public-read containers).
# POD_OIDC_CLIENT_ID=
# POD_OIDC_CLIENT_SECRET=

# --- Transport (optional, defaults to stdio for Claude Desktop) ---
# Set to streamable-http to run as an HTTP server requiring MCP-client OAuth.
# MCP_TRANSPORT=streamable-http
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8000
# Only needed when tunnelling (e.g. ngrok) — must be the public URL, not localhost:
# MCP_RESOURCE_URL=https://your-tunnel-subdomain.ngrok-free.dev/mcp
